{
  "manifest_version": 3,
  "name": "PitchPilot AI",
  "version": "1.1.0",
  "description": "Prepare a session, then use PitchPilot in Chrome's side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "storage", "scripting"],
  "host_permissions": [
    "https://pitchpilot-ai-ruddy.vercel.app/*",
    "http://localhost/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PitchPilot",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pitchpilot-ai-ruddy.vercel.app/*",
        "http://localhost/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
