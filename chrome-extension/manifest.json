{
  "manifest_version": 3,
  "name": "PitchPilot Sidekick",
  "version": "1.0.0",
  "description": "A private interview and coding copilot in Chrome's side panel.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "activeTab", "storage"],
  "host_permissions": ["http://localhost:3000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open PitchPilot Sidekick"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
