{
  "manifest_version": 3,
  "name": "PitchPilot AI",
  "version": "1.1.0",
  "description": "Popup-native stealth AI copilot tool for Microsoft Teams, Google Meet, and Zoom screen sharing.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "activeTab", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PitchPilot Stealth Copilot"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pitchpilot-ai-ruddy.vercel.app/*",
        "http://localhost/*",
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://meet.google.com/*",
        "https://*.zoom.us/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
