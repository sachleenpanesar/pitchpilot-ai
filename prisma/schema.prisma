datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String                @id @default(cuid())
  name             String?
  email            String                @unique
  passwordHash     String
  otpCode          String?
  otpExpiresAt     DateTime?
  role             String                @default("USER") // ADMIN, USER
  isAdmin          Boolean               @default(false)
  credits          Int                   @default(50)
  plan             String                @default("FREE") // FREE, PRO, UNLIMITED
  proExpiresAt     DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  documents        Document[]
  sessions         Session[]
  paymentRequests  PaymentRequest[]
  supportTickets   SupportTicket[]
  promoRedemptions PromoCodeRedemption[]
  creditUsage      CreditUsage[]
}

model SupportTicket {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   String
  status    String           @default("OPEN") // OPEN, RESOLVED
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  messages  SupportMessage[]

  @@index([userId, updatedAt])
  @@index([status, updatedAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole String // USER, ADMIN
  message    String
  isRead     Boolean       @default(false)
  createdAt  DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@index([ticketId, senderRole, isRead])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  docType   String // RESUME, STAR_STORY, PLAYBOOK, JOB_DESC
  content   String // Text or JSON content
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  companyOrClient String   @default("General")
  mode            String // MOCK_INTERVIEW, LIVE_COPILOT
  language        String   @default("English")
  status          String   @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  durationSeconds Int      @default(0)
  transcript      String? // JSON or text
  aiNotes         String?
  scorecard       String? // JSON
  followUpEmail   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSetting {
  id              String   @id @default(cuid())
  heroTitle       String   @default("PitchPilot AI - Stealth Interview Copilot")
  heroSubtitle    String   @default("Ace interviews and pitch calls with real-time AI prompts completely undetectable on screen share.")
  starterCredits  Int      @default(50)
  weeklyPriceInr  Int      @default(499)
  monthlyPriceInr Int      @default(1499)
  upiId           String   @default("")
  upiPayeeName    String   @default("")
  updatedAt       DateTime @updatedAt
}

model PaymentRequest {
  id                String               @id @default(cuid())
  userId            String
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  planOrPack        String
  amountInr         Int
  utrNumber         String?              @unique
  originalAmountInr Int?
  discountPercent   Int                  @default(0)
  promoRedemptionId String?
  promoRedemption   PromoCodeRedemption? @relation(fields: [promoRedemptionId], references: [id], onDelete: Restrict)
  status            String               @default("PENDING")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model PromoCode {
  id              String                @id @default(cuid())
  code            String                @unique
  bonusCredits    Int                   @default(0)
  discountPercent Int                   @default(0)
  maxUses         Int?
  usedCount       Int                   @default(0)
  expiresAt       DateTime?
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  redemptions     PromoCodeRedemption[]

  @@index([isActive, expiresAt])
}

model PromoCodeRedemption {
  id              String           @id @default(cuid())
  promoCodeId     String
  promoCode       PromoCode        @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  discountPercent Int              @default(0)
  status          String           @default("AVAILABLE") // AVAILABLE, RESERVED, CONSUMED
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentRequests PaymentRequest[]

  @@unique([promoCodeId, userId])
  @@index([userId, status])
}

model CreditUsage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credits   Int // Positive for metered use; negative for a refund.
  source    String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}
